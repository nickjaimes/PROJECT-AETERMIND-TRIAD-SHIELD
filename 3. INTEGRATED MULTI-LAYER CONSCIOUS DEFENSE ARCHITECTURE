        missile_score = await self._calculate_missile_score(threat, context)
        
        # Apply cost-effectiveness weighting
        cost_weighted_laser = laser_score * self._calculate_cost_weight("laser")
        cost_weighted_missile = missile_score * self._calculate_cost_weight("missile")
        
        # Apply environmental adjustments
        env_adjusted_laser = cost_weighted_laser * self._environmental_factor("laser")
        env_adjusted_missile = cost_weighted_missile * self._environmental_factor("missile")
        
        # Consider system readiness
        readiness_adjusted_laser = env_adjusted_laser * system_status.get("laser_readiness", 1.0)
        readiness_adjusted_missile = env_adjusted_missile * system_status.get("missile_readiness", 1.0)
        
        # Apply ethical constraints
        final_laser_score = await self._apply_ethical_constraints(
            readiness_adjusted_laser, threat, "laser"
        )
        final_missile_score = await self._apply_ethical_constraints(
            readiness_adjusted_missile, threat, "missile"
        )
        
        # Decision logic
        if final_laser_score >= final_missile_score:
            # Check if laser meets minimum threshold
            if final_laser_score >= self.switching_thresholds["laser_to_missile"]:
                selected_layer = "laser"
            else:
                selected_layer = "missile"
        else:
            selected_layer = "missile"
        
        # Consider combined approach for critical threats
        if threat.get("priority", 0) >= 90:  # Critical threat
            if final_laser_score > 0.6 and final_missile_score > 0.6:
                selected_layer = "combined"
        
        decision_time = (datetime.utcnow() - start_time).total_seconds()
        
        return {
            "selected_layer": selected_layer,
            "laser_score": final_laser_score,
            "missile_score": final_missile_score,
            "decision_time": decision_time,
            "confidence": max(final_laser_score, final_missile_score),
            "rationale": self._generate_rationale(
                selected_layer, final_laser_score, final_missile_score, threat
            )
        }
    
    async def _calculate_laser_score(self,
                                   threat: Dict[str, Any],
                                   context: Dict[str, Any]) -> float:
        """Calculate effectiveness score for laser engagement"""
        
        score = 1.0
        
        # Range factor (0-1)
        threat_range = threat.get("range", 0)
        max_laser_range = 20000  # 20 km
        
        if threat_range > max_laser_range:
            range_factor = 0.0
        else:
            range_factor = 1.0 - (threat_range / max_laser_range) ** 2
        
        score *= range_factor
        
        # Speed factor - lasers work better on slower targets
        threat_speed = threat.get("speed", 0)
        max_effective_speed = 1000  # m/s
        
        if threat_speed > max_effective_speed:
            speed_factor = 0.3
        else:
            speed_factor = 1.0 - (threat_speed / max_effective_speed) ** 2
        
        score *= speed_factor
        
        # Material factor - some materials are harder to burn
        material = threat.get("material", "aluminum")
        material_factors = {
            "aluminum": 0.9,
            "steel": 0.7,
            "composite": 0.8,
            "ceramic": 0.5
        }
        score *= material_factors.get(material, 0.7)
        
        # Atmospheric conditions
        weather = context.get("weather", "clear")
        weather_factors = {
            "clear": 1.0,
            "cloudy": 0.9,
            "rain": 0.6,
            "fog": 0.4,
            "sandstorm": 0.2
        }
        score *= weather_factors.get(weather, 0.8)
        
        # Historical performance
        if self.performance_history["laser"]:
            historical_factor = np.mean(self.performance_history["laser"])
            score *= historical_factor
        
        return max(0.0, min(1.0, score))
    
    def _calculate_cost_weight(self, layer: str) -> float:
        """Calculate cost-effectiveness weight"""
        
        cost_per_engagement = {
            "laser": 10,        # $10 per shot (electricity + maintenance)
            "iron_beam": 3.5,   # $3.50 per shot
            "iron_dome": 50000, # $50,000 per interceptor
            "patriot": 3000000, # $3 million per interceptor
            "arrow_3": 10000000 # $10 million per interceptor
        }
        
        # Normalize to 0-1 scale (lower cost = higher weight)
        max_cost = max(cost_per_engagement.values())
        
        if layer == "laser":
            cost = cost_per_engagement["laser"]
        elif layer == "missile":
            # Use average missile cost
            missile_costs = [cost_per_engagement["iron_dome"], 
                           cost_per_engagement["patriot"],
                           cost_per_engagement["arrow_3"]]
            cost = np.mean(missile_costs)
        else:
            cost = max_cost
        
        # Invert cost (lower cost = higher weight)
        cost_weight = 1.0 - (cost / max_cost)
        
        # Add minimum weight to ensure cost isn't everything
        return 0.3 + 0.7 * cost_weight  # Cost is 70% of weight
