# monitoring/layered_defense_metrics.py

from typing import Dict, List, Any
import time
import numpy as np
from dataclasses import dataclass
from datetime import datetime

@dataclass
class DefenseMetrics:
    """Comprehensive metrics for layered defense"""
    
    # Timing metrics
    detection_time: float  # seconds from launch to detection
    decision_time: float   # seconds from detection to decision
    engagement_time: float # seconds from decision to engagement
    total_time: float     # total engagement time
    
    # Effectiveness metrics
    interception_success: bool
    layer_used: str       # "laser", "missile", "combined"
    cost: float          # cost in dollars
    energy_used: float   # energy in joules
    
    # Safety metrics
    civilian_risk: float  # 0-1 scale
    collateral_damage: float  # estimated damage
    ethical_compliance: float # 0-1 scale
    
    # System metrics
    laser_temperature: float  # Kelvin
    missile_inventory: Dict[str, int]
    quantum_coherence: float
    consciousness_level: float

class LayeredDefenseMonitor:
    """Monitor for layered defense system"""
    
    def __init__(self):
        self.metrics_history = []
        self.real_time_metrics = {
            "laser_success_rate": 0.95,
            "missile_success_rate": 0.92,
            "combined_success_rate": 0.99,
            "average_response_time": 0.0,
            "cost_per_interception": 0.0,
            "civilian_safety_index": 1.0
        }
        
        # Performance thresholds
        self.thresholds = {
            "min_success_rate": 0.9,
            "max_response_time": 10.0,  # seconds
            "max_cost_per_interception": 100000.0,  # dollars
            "min_civilian_safety": 0.95
        }
    
    def record_engagement(self, metrics: DefenseMetrics):
        """Record engagement metrics"""
        
        self.metrics_history.append({
            "timestamp": datetime.utcnow().isoformat(),
            "metrics": metrics
        })
        
        # Update real-time metrics
        self._update_real_time_metrics(metrics)
        
        # Check for threshold violations
        violations = self._check_threshold_violations(metrics)
        
        if violations:
            self._trigger_alerts(violations, metrics)
    
    def _update_real_time_metrics(self, metrics: DefenseMetrics):
        """Update real-time performance metrics"""
        
        # Calculate success rates
        recent_engagements = self.metrics_history[-100:]  # Last 100 engagements
        
        if recent_engagements:
            laser_engagements = [m for m in recent_engagements 
                               if m["metrics"].layer_used == "laser"]
            missile_engagements = [m for m in recent_engagements 
                                 if m["metrics"].layer_used == "missile"]
            combined_engagements = [m for m in recent_engagements 
                                  if m["metrics"].layer_used == "combined"]
            
            if laser_engagements:
                self.real_time_metrics["laser_success_rate"] = np.mean(
                    [m["metrics"].interception_success for m in laser_engagements]
                )
            
            if missile_engagements:
                self.real_time_metrics["missile_success_rate"] = np.mean(
                    [m["metrics"].interception_success for m in missile_engagements]
                )
            
            if combined_engagements:
                self.real_time_metrics["combined_success_rate"] = np.mean(
                    [m["metrics"].interception_success for m in combined_engagements]
                )
            
            # Update average response time
            self.real_time_metrics["average_response_time"] = np.mean(
                [m["metrics"].total_time for m in recent_engagements]
            )
            
            # Update cost per interception
            self.real_time_metrics["cost_per_interception"] = np.mean(
                [m["metrics"].cost for m in recent_engagements 
                 if m["metrics"].interception_success]
            )
            
            # Update civilian safety index
            self.real_time_metrics["civilian_safety_index"] = np.mean(
                [m["metrics"].civilian_risk for m in recent_engagements]
            )
    
    def generate_performance_report(self) -> Dict[str, Any]:
        """Generate comprehensive performance report"""
        
        if not self.metrics_history:
            return {"error": "No engagement data"}
        
        # Calculate statistics
        total_engagements = len(self.metrics_history)
        successful_engagements = sum(
            1 for m in self.metrics_history 
            if m["metrics"].interception_success
        )
        
        success_rate = successful_engagements / total_engagements if total_engagements > 0 else 0
        
        # Layer usage statistics
        layer_usage = {}
        for layer in ["laser", "missile", "combined"]:
            layer_engagements = [m for m in self.metrics_history 
                               if m["metrics"].layer_used == layer]
            if layer_engagements:
                layer_success = sum(
                    1 for m in layer_engagements 
                    if m["metrics"].interception_success
                )
                layer_usage[layer] = {
                    "count": len(layer_engagements),
                    "success_rate": layer_success / len(layer_engagements),
                    "percentage": len(layer_engagements) / total_engagements * 100
                }
        
        # Cost analysis
        total_cost = sum(m["metrics"].cost for m in self.metrics_history)
        cost_per_success = total_cost / successful_engagements if successful_engagements > 0 else 0
        
        # Time analysis
        response_times = [m["metrics"].total_time for m in self.metrics_history]
        
        return {
            "report_timestamp": datetime.utcnow().isoformat(),
            "engagement_summary": {
                "total_engagements": total_engagements,
                "successful_engagements": successful_engagements,
                "success_rate": success_rate,
                "failure_rate": 1 - success_rate
            },
            "layer_performance": layer_usage,
            "cost_analysis": {
                "total_cost": total_cost,
                "average_cost_per_engagement": total_cost / total_engagements if total_engagements > 0 else 0,
                "cost_per_successful_interception": cost_per_success,
                "cost_effectiveness_ratio": self._calculate_cost_effectiveness()
            },
            "time_analysis": {
                "average_response_time": np.mean(response_times) if response_times else 0,
                "median_response_time": np.median(response_times) if response_times else 0,
                "response_time_95th_percentile": np.percentile(response_times, 95) if response_times else 0,
                "fastest_response": min(response_times) if response_times else 0,
                "slowest_response": max(response_times) if response_times else 0
            },
            "safety_metrics": {
                "average_civilian_risk": np.mean([m["metrics"].civilian_risk 
                                                for m in self.metrics_history]),
                "average_collateral_damage": np.mean([m["metrics"].collateral_damage 
                                                    for m in self.metrics_history]),
                "ethical_compliance_rate": np.mean([m["metrics"].ethical_compliance 
                                                  for m in self.metrics_history])
            },
            "system_health": {
                "average_laser_temperature": np.mean([m["metrics"].laser_temperature 
                                                    for m in self.metrics_history]),
                "average_quantum_coherence": np.mean([m["metrics"].quantum_coherence 
                                                    for m in self.metrics_history]),
                "average_consciousness_level": np.mean([m["metrics"].consciousness_level 
                                                      for m in self.metrics_history])
            },
            "recommendations": self._generate_recommendations()
        }
