class EthicalDecisionFramework:
    """Framework for ethical defense decisions"""
    
    def evaluate_engagement(self, threat, context):
        # Calculate civilian risk
        civilian_risk = self.calculate_civilian_risk(threat, context)
        
        # Check proportionality
        proportional = self.check_proportionality(threat, context)
        
        # Check necessity
        necessary = self.check_necessity(threat, context)
        
        # Check discrimination (combatant vs non-combatant)
        discriminating = self.check_discrimination(threat, context)
        
        # Calculate overall ethical score
        ethical_score = (
            0.4 * (1 - civilian_risk) +
            0.3 * proportional +
            0.2 * necessary +
            0.1 * discriminating
        )
        
        # Apply threshold
        if ethical_score < self.thresholds["minimum_ethical"]:
            return {
                "approved": False,
                "ethical_score": ethical_score,
                "violations": self.identify_violations(
                    civilian_risk, proportional, necessary, discriminating
                )
            }
        else:
            return {
                "approved": True,
                "ethical_score": ethical_score,
                "confidence": self.calculate_confidence(ethical_score)
            }
