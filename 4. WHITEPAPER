8.2.3 Cost-Benefit Analysis

```python
def calculate_cost_benefit(annual_attacks, system_cost):
    """
    Calculate cost-benefit of defense system
    """
    
    # Conservative estimates
    attacks_prevented = annual_attacks * 0.999  # 99.9% success rate
    
    # Cost of damage prevented
    average_damage_per_attack = 100000000  # $100M average
    total_damage_prevented = attacks_prevented * average_damage_per_attack
    
    # Economic continuity value
    economic_impact_per_attack = 500000000  # $500M economic disruption
    economic_value = attacks_prevented * economic_impact_per_attack
    
    # Deterrence value (attacks prevented through deterrence)
    deterrence_factor = 10  # Conservative estimate
    deterred_attacks = annual_attacks * deterrence_factor
    deterrence_value = deterred_attacks * (average_damage_per_attack + economic_impact_per_attack)
    
    # Total value
    total_value = total_damage_prevented + economic_value + deterrence_value
    
    # Return on investment
    roi = total_value / system_cost
    
    return {
        "annual_attacks": annual_attacks,
        "attacks_prevented": attacks_prevented,
        "damage_prevented": total_damage_prevented,
        "economic_value": economic_value,
        "deterrence_value": deterrence_value,
        "total_value": total_value,
        "system_cost": system_cost,
        "roi": roi,
        "payback_period": system_cost / total_value  # years
    }
