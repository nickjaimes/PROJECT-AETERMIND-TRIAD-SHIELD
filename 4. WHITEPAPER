5.1.2 Layer Selection Algorithm

```python
class LayerSelectionAlgorithm:
    """Algorithm for selecting optimal defense layer"""
    
    def select_layer(self, threat, context):
        # Calculate effectiveness scores
        laser_score = self.calculate_laser_score(threat, context)
        missile_score = self.calculate_missile_score(threat, context)
        
        # Apply cost weighting
        cost_weighted_laser = laser_score * self.cost_weight("laser")
        cost_weighted_missile = missile_score * self.cost_weight("missile")
        
        # Apply ethical constraints
        ethical_laser = self.apply_ethical_constraints(
            cost_weighted_laser, threat, "laser"
        )
        ethical_missile = self.apply_ethical_constraints(
            cost_weighted_missile, threat, "missile"
        )
        
        # Make decision
        if ethical_laser >= ethical_missile:
            if ethical_laser > self.thresholds["min_laser_effectiveness"]:
                return "laser"
            else:
                return "missile"
        else:
            return "missile"
    
    def cost_weight(self, layer):
        """Calculate cost-effectiveness weight"""
        costs = {
            "laser": 10,
            "iron_beam": 3.5,
            "iron_dome": 50000,
            "patriot": 3000000,
            "arrow_3": 10000000
        }
        
        # Invert cost (lower cost = higher weight)
        max_cost = max(costs.values())
        cost = costs.get(layer, max_cost)
        return 1.0 - (cost / max_cost)
```

