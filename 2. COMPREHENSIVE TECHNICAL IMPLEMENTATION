// realtime/realtime_scheduler.cpp

#pragma once

#include <vector>
#include <queue>
#include <atomic>
#include <chrono>
#include <mutex>
#include <condition_variable>

class RealTimeScheduler {
private:
    struct Task {
        std::string id;
        std::function<void()> function;
        std::chrono::microseconds deadline;
        int priority;
        std::chrono::steady_clock::time_point arrival_time;
        
        bool operator<(const Task& other) const {
            // Higher priority first, then earlier deadline
            if (priority != other.priority)
                return priority < other.priority;
            return deadline > other.deadline;
        }
    };
    
    std::priority_queue<Task> task_queue;
    std::mutex queue_mutex;
    std::condition_variable cv;
    std::vector<std::thread> worker_threads;
    std::atomic<bool> running{true};
    
    // EDF (Earliest Deadline First) scheduling
    std::vector<Task> edf_schedule;
    
public:
    RealTimeScheduler(int num_workers = 8) {
        // Create worker threads
        for (int i = 0; i < num_workers; ++i) {
            worker_threads.emplace_back(&RealTimeScheduler::worker_loop, this);
        }
    }
    
    ~RealTimeScheduler() {
        running = false;
        cv.notify_all();
        for (auto& thread : worker_threads) {
            if (thread.joinable()) thread.join();
        }
    }
    
    void schedule_task(const std::string& id, 
                      std::function<void()> task_func,
                      std::chrono::microseconds deadline,
                      int priority = 0) {
        
        Task task{
            id,
            task_func,
            deadline,
            priority,
            std::chrono::steady_clock::now()
        };
        
        {
            std::lock_guard<std::mutex> lock(queue_mutex);
            task_queue.push(task);
        }
        
        cv.notify_one();
    }
    
    void schedule_defensive_task(const ThreatData& threat,
                                std::function<void(DefenseResult)> callback) {
        
        // Calculate optimal scheduling based on threat type
        auto [deadline, priority] = calculate_scheduling_parameters(threat);
        
        schedule_task(
            "defense_" + threat.id,
            [this, threat, callback]() {
                auto result = process_threat_defense(threat);
                callback(result);
            },
            deadline,
            priority
        );
    }
    
private:
    void worker_loop() {
        while (running) {
            Task task;
            
            {
                std::unique_lock<std::mutex> lock(queue_mutex);
                cv.wait(lock, [this]() {
                    return !task_queue.empty() || !running;
                });
                
                if (!running) break;
                
                if (!task_queue.empty()) {
                    task = task_queue.top();
                    task_queue.pop();
                }
            }
            
            if (task.function) {
                // Check if we can still meet deadline
                auto now = std::chrono::steady_clock::now();
                auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
                    now - task.arrival_time
                );
                
                if (elapsed < task.deadline) {
                    // Execute task
                    task.function();
                    
                    // Record completion time
                    record_completion_time(task.id, elapsed);
                } else {
                    // Deadline missed - execute emergency procedure
                    execute_emergency_procedure(task.id);
                }
            }
        }
    }
    
    std::pair<std::chrono::microseconds, int> 
    calculate_scheduling_parameters(const ThreatData& threat) {
        
        // Calculate deadline based on threat characteristics
        std::chrono::microseconds deadline;
        int priority = 0;
        
        switch (threat.type) {
            case ThreatType::HYPERSONIC:
                deadline = std::chrono::microseconds(3000); // 3ms
                priority = 10; // Highest priority
                break;
                
            case ThreatType::CRUISE_MISSILE:
                deadline = std::chrono::microseconds(5000); // 5ms
                priority = 8;
                break;
                
            case ThreatType::BALLISTIC:
                deadline = std::chrono::microseconds(10000); // 10ms
                priority = 6;
                break;
                
            case ThreatType::DRONE_SWARM:
                deadline = std::chrono::microseconds(8000); // 8ms
                priority = 7;
                break;
                
            default:
                deadline = std::chrono::microseconds(15000); // 15ms
                priority = 5;
        }
        
        // Adjust based on proximity to populated areas
        if (threat.proximity_to_civilians < 1000) { // within 1km
            deadline /= 2; // Halve deadline for close threats
            priority += 2;
        }
        
        return {deadline, priority};
    }
};
