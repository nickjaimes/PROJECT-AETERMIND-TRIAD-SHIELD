            "interception_point": {
                "lat": command["interception_point"]["latitude"],
                "lon": command["interception_point"]["longitude"],
                "alt": command["interception_point"]["altitude"]
            },
            "fuse_settings": {
                "proximity": command.get("fuse_proximity", 10),  # meters
                "delay": command.get("fuse_delay", 0.1)  # seconds
            },
            "priority": command.get("priority", "HIGH"),
            "timestamp": command.get("timestamp", self._get_current_timestamp())
        }
        
        # Add validation data
        iron_dome_command["validation_hash"] = self._calculate_command_hash(
            iron_dome_command
        )
        
        return iron_dome_command
    
    async def _send_command(self, command: Dict[str, Any]) -> bool:
        """Send command to Iron Dome"""
        
        if "main" not in self.connections:
            await self.connect()
        
        connection = self.connections["main"]
        
        try:
            # Convert to Iron Dome binary format
            binary_data = self._command_to_binary(command)
            
            # Send data
            connection["writer"].write(binary_data)
            await connection["writer"].drain()
            
            # Wait for acknowledgment
            ack_data = await connection["reader"].read(1024)
            ack = self._binary_to_command(ack_data)
            
            return ack.get("status") == "ACK"
            
        except Exception as e:
            print(f"Failed to send command: {e}")
            return False
    
    def _command_to_binary(self, command: Dict[str, Any]) -> bytes:
        """Convert command to Iron Dome binary format"""
        
        # Iron Dome uses custom binary protocol
        # Format: [header][command_type][data_length][data][checksum]
        
        header = b'\xAA\x55'  # Start bytes
        command_type = command["command_type"].encode('ascii')
        data = json.dumps(command).encode('utf-8')
        data_length = struct.pack('I', len(data))
        
        # Calculate checksum
        checksum = self._calculate_checksum(header + command_type + data_length + data)
        
        return header + command_type + data_length + data + checksum
