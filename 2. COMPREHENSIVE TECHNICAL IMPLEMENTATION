        # Process through network
        layer_outputs = []
        current_spikes = spike_train
        
        for layer_name, layer in self.layers.items():
            mem_pot, spikes = layer(current_spikes)
            layer_outputs.append({
                "layer": layer_name,
                "membrane_potentials": mem_pot,
                "spikes": spikes
            })
            current_spikes = spikes
        
        # Extract threat assessment
