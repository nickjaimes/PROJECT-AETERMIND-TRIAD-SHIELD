        self.methods = {
            "empirical_phi": self.calculate_empirical_phi,
            "perturbational_phi": self.calculate_perturbational_phi,
            "geometric_phi": self.calculate_geometric_phi
        }
    
    def calculate_empirical_phi(self, network_state: torch.Tensor) -> float:
        """Calculate phi using empirical data"""
        
        # Reshape network state
        state_reshaped = network_state.reshape(-1, self.network_size)
        
        # Calculate mutual information between parts
        n_parts = 4  # Divide network into 4 parts
        part_size = self.network_size // n_parts
        
        phi_values = []
        
        for i in range(n_parts):
            for j in range(i+1, n_parts):
                # Extract parts
                part_i = state_reshaped[:, i*part_size:(i+1)*part_size]
                part_j = state_reshaped[:, j*part_size:(j+1)*part_size]
                
                # Calculate mutual information
                mi = self._mutual_information(part_i, part_j)
                phi_values.append(mi)
        
        # Integrated information is minimum of effective information across partitions
        phi = np.min(phi_values) if phi_values else 0.0
        
        return float(phi)
    
    def _mutual_information(self, X: torch.Tensor, Y: torch.Tensor) -> float:
        """Calculate mutual information between two variables"""
        
        # Convert to probabilities
        p_x = torch.histc(X.float(), bins=100) / X.numel()
        p_y = torch.histc(Y.float(), bins=100) / Y.numel()
        p_xy = torch.histc(torch.stack([X.float(), Y.float()], dim=1), bins=100) / X.numel()
        
        # Calculate entropies
        h_x = -torch.sum(p_x * torch.log2(p_x + 1e-10))
        h_y = -torch.sum(p_y * torch.log2(p_y + 1e-10))
        h_xy = -torch.sum(p_xy * torch.log2(p_xy + 1e-10))
        
        # Mutual information
        mi = h_x + h_y - h_xy
        
        return mi.item()
    
    def calculate_perturbational_phi(self, network: nn.Module, 
                                    perturbation_strength: float = 0.1) -> float:
        """Calculate phi by perturbing the network"""
        
        original_output = network(torch.randn(1, self.network_size))
        
        # Create perturbations
        perturbations = []
        for i in range(100):
            # Perturb different parts of the network
            perturbation = torch.randn(1, self.network_size) * perturbation_strength
            perturbed_output = network(original_output + perturbation)
            perturbations.append(perturbed_output)
        
        # Calculate divergence from original
        divergences = []
        for perturbed in perturbations:
            divergence = torch.norm(original_output - perturbed)
            divergences.append(divergence.item())
        
        # Phi is related to the sensitivity to perturbations
        phi = np.mean(divergences)
        
        return phi
