        # Update learning based on outcome
        self._update_learning(spike_train, threat_assessment)
        
        return {
            "threat_assessment": threat_assessment,
            "layer_activations": layer_outputs,
            "total_spikes": torch.sum(current_spikes).item(),
            "temporal_pattern": self._extract_temporal_pattern(current_spikes)
        }
    
    def _stdp_learning(self, pre_spikes: torch.Tensor, post_spikes: torch.Tensor):
        """Spike-timing dependent plasticity learning rule"""
        
        # STDP parameters
        A_plus = 0.01  # Potentiation rate
        A_minus = 0.012  # Depression rate
        tau_plus = 20.0  # Potentiation time constant
        tau_minus = 20.0  # Depression time constant
        
        # Calculate time differences
        time_diff = self._calculate_spike_time_differences(pre_spikes, post_spikes)
        
        # Apply STDP rule
        weight_update = torch.zeros_like(self.synaptic_weights)
        
        potentiation_mask = time_diff > 0
        depression_mask = time_diff < 0
        
        weight_update[potentiation_mask] = A_plus * torch.exp(-time_diff[potentiation_mask] / tau_plus)
        weight_update[depression_mask] = -A_minus * torch.exp(time_diff[depression_mask] / tau_minus)
        
        # Update weights
        self.synaptic_weights += weight_update
        
        # Clip weights to reasonable range
        self.synaptic_weights = torch.clamp(self.synaptic_weights, -1.0, 1.0)
        
        return weight_update
